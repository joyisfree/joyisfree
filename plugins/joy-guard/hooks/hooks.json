{
  "description": "The destructive-command guard on every Bash call; a crash, a failure to start or a timeout blocks the call",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/guard.mjs\" || exit 2",
            "timeout": 5,
            "onFailure": "block"
          }
        ]
      }
    ]
  }
}
