{
  "name": "joyisfree",
  "version": "0.1.0",
  "private": true,
  "description": "Joyisfree Studio: the Galxe Desk and other non-studio tracks. No dependencies on purpose.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "node --test galxe-desk/scripts/*.test.mjs .claude/skills/joy-revise/scripts/*.test.mjs",
    "worth-it": "node .claude/skills/joy-revise/scripts/worth-it.mjs",
    "desk:rank": "node galxe-desk/scripts/rank.mjs",
    "desk:ledger": "node galxe-desk/scripts/ledger.mjs",
    "desk:status": "node galxe-desk/scripts/ledger.mjs status",
    "desk:crawl": "node galxe-desk/scripts/rulebook-crawl.mjs",
    "desk:check": "node galxe-desk/scripts/rulebook-crawl.mjs --check",
    "desk:card": "node galxe-desk/scripts/do-card.mjs",
    "desk:verify": "node galxe-desk/scripts/verify-link.mjs",
    "desk:due": "node galxe-desk/scripts/ledger.mjs due",
    "desk:gigapot": "node galxe-desk/scripts/gigapot.mjs",
    "desk:mutate": "node galxe-desk/scripts/mutate.mjs"
  }
}
